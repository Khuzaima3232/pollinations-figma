{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["ES2017"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"typeRoots": ["node_modules/@types", "node_modules/@figma"],
		"moduleResolution": "node",
		"skipLibCheck": true
	},
	"include": ["code.ts"]
}
